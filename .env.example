# Для локального запуска Python; Compose подставляет имена своих сервисов.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/
API_KEY=dev-api-key
PROVIDER_URL=http://localhost:8001
PROVIDER_API_KEY=dev-provider-key
PROVIDER_DELAY_MIN=2
PROVIDER_DELAY_MAX=5
OUTBOX_POLL_INTERVAL=0.5
